rgds_android_boot=mmc dev 0 && part start mmc 0 boot boot_start && part size mmc 0 boot boot_size && mmc read ${loadaddr} ${boot_start} ${boot_size} && part start mmc 0 dtbo dtbo_start && part size mmc 0 dtbo dtbo_size && mmc read 0x05000000 ${dtbo_start} ${dtbo_size} && abootimg get dtb --index=0 dtb_addr dtb_size && cp.b ${dtb_addr} 0x06000000 ${dtb_size} && fdt addr 0x06000000 0x00100000 && adtimg addr 0x05000000 && adtimg get dt --index=0 dtbo_addr dtbo_size && cp.b ${dtbo_addr} 0x06200000 ${dtbo_size} && fdt apply 0x06200000 && setenv bootargs androidboot.verifiedbootstate=orange && bootm ${loadaddr} ${loadaddr} 0x06000000
